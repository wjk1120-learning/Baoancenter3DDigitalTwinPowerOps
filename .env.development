# mock 总开关：true = REST/会话全部走 src/mock（不出网络）；联调时改 false
VITE_USE_MOCK=true

# 本地 npm run dev。浏览器要打开的运维地址。
VITE_AUTH_LOGIN_URL=http://47.112.199.80/opsPlatform/login
VITE_OPERATIONS_URL=http://47.112.199.80/opsPlatform/

# 仅 Vite 开发代理使用，不加 VITE_ 前缀，不会打进前端包。
# AUTH_PROXY_TARGET / WS_PROXY_TARGET = 认证中心（运维平台同款基础设施）；
# FY_PROXY_TARGET 是福永数据后端，宝中新 vite.config 只认 BZ_PROXY_TARGET ——
# 宝中数据后端就绪后把下面这行解注并换成宝中地址（联调时配合 VITE_USE_MOCK=false）：
# BZ_PROXY_TARGET=http://<宝中数据后端IP>:8080
AUTH_PROXY_TARGET=http://47.112.199.80:8088
# 事件 WS 与数据后端同源（福永同款），宝中数据后端就绪后解注：
# WS_PROXY_TARGET=ws://<宝中数据后端IP>:8080
